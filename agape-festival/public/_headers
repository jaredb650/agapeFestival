# Cloudflare Pages response headers (GitHub Pages ignores this file).
# HTML keeps Pages' default (max-age=0, must-revalidate), so a deploy is live at once.

# Content-hashed by Next (JS, CSS, fonts): never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps stable names, so cache for a week and revalidate in the background after that.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Frame packs are content-hashed (p<n>.<sha>.bin): immutable.
/assets/winter/bg/packs/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
